# Пример файла переменных окружения для Qdrant Manager
# Скопируйте этот файл в .env и заполните своими значениями

# URL для подключения к Qdrant
# Для локального Qdrant:
QDRANT_URL=http://localhost:6333

# Для удаленного Qdrant с SSL:
# QDRANT_URL=https://your-qdrant.com:6333

# API ключ для аутентификации (опционально)
# Получите ключ в панели управления Qdrant
QDRANT_API_KEY=your-api-key-here

# Настройки подключения (опционально)
# QDRANT_TIMEOUT=30
# QDRANT_RETRY_ATTEMPTS=3

# Примеры использования:
# 1. Локальный Qdrant без аутентификации
# QDRANT_URL=http://localhost:6333

# 2. Удаленный Qdrant с аутентификацией
# QDRANT_URL=https://qdrant.example.com:6333
# QDRANT_API_KEY=sk-your-secret-api-key

# 3. Qdrant Cloud
# QDRANT_URL=https://your-cluster.qdrant.io:6333
# QDRANT_API_KEY=your-cloud-api-key