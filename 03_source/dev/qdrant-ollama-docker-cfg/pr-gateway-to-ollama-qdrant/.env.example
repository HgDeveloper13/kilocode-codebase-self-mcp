# ============================================
# ASP.NET Core Gateway Configuration
# ============================================

# External port for ASP.NET Core Gateway
GATEWAY_PORT=8080

# .NET Environment (Development, Production, Staging)
ASPNETCORE_ENVIRONMENT=Development

# ============================================
# Upstream Services
# ============================================

# Ollama service URL
OLLAMA_URL=http://localhost:11434

# Qdrant service URL
QDRANT_URL=http://localhost:6333

# ============================================
# Ollama Configuration
# ============================================

# External port for Ollama API
OLLAMA_PORT=11434

# Number of parallel requests
OLLAMA_NUM_PARALLEL=1

# Maximum number of loaded models
OLLAMA_MAX_LOADED_MODELS=1

# GPU layers (0 = CPU only, -1 = all layers on GPU)
OLLAMA_GPU_LAYERS=0

# Number of CPU threads
OLLAMA_NUM_THREADS=4

# Maximum queue size for requests
OLLAMA_MAX_QUEUE=1024

# Model keep-alive duration (e.g., "2h", "30m", "-1" for infinite)
OLLAMA_KEEP_ALIVE=2h

# Enable debug logging (true/false)
OLLAMA_DEBUG=false

# ============================================
# Qdrant Configuration
# ============================================

# External port for Qdrant HTTP API
QDRANT_HTTP_PORT=6333

# External port for Qdrant gRPC API
QDRANT_GRPC_PORT=6334

# Disable telemetry (true/false)
QDRANT_TELEMETRY_DISABLED=true
